def extract_image_color(image_path):
    image = Image.open(image_path).convert('RGB')
    image = image.resize((100, 100))

    simplified = image.quantize(colors=5).convert('RGB')
    color_counts = simplified.getcolors()

    dominant_rgb = max(color_counts)[1]

    hex_color = f"{dominant_rgb[0]:02X}{dominant_rgb[1]:02X}{dominant_rgb[2]:02X}"

    return hex_color


def request_color(user_input_color, user_input_mode, user_input_count):
    my_data = {
        'hex': user_input_color,
        'mode': user_input_mode,
        'count': user_input_count
    }

    try:
        response = requests.get(url, params=my_data, timeout=15)
        response.raise_for_status()
        data = response.json()

    except requests.exceptions.RequestException as error:
        print("API request failed:", error)
        return [], []

    colors = data['colors']
    hex_colors = [color['hex']['value'] for color in colors]
    color_names = [color['name']['value'] for color in colors]

    return hex_colors, color_names


#DRAW PALETTE
def create_palette(hex_colors, color_names):
    
    block_width = 120
    palette_width = len(hex_colors) * block_width
    palette_height = 150

    palette = Image.new('RGB', (palette_width, palette_height), 'white')
    draw = ImageDraw.Draw(palette)

    for i, color in enumerate(hex_colors):
        x0 = i * block_width
        x1 = (i + 1) * block_width

        draw.rectangle((x0, 0, x1, 100), fill=color)
        draw.text((x0 + 20, 110), color, fill='black')
        draw.text((x0 + 20, 123), color_names[i], fill='black')

    return palette
    


user_input_color, user_input_mode, user_input_count = get_user_inputs()
hex_colors, color_names = request_color(user_input_color, user_input_mode, user_input_count)

palette_image = create_palette(hex_colors, color_names)
palette_image.show()
palette_image.save("palette.png")
