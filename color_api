import requests
from PIL import Image, ImageDraw

url = "https://www.thecolorapi.com/scheme"


user_input = input("Enter a hex color code (without #): ")

valid_modes = ['monochrome', 'monochrome-dark', 'monochrome-light', 'analogic', 'complement', 'analogic-complement', 'triad', 'quad']
user_input_mode = input("Enter a color mode (e.g., 'analogic', 'monochrome', 'complement', etc.): ").strip().lower()

while user_input_mode not in valid_modes:
    print("Invalid mode. Try again!")
    user_input_mode = input("Enter a color mode: ").strip().lower()

print("You selected:", user_input_mode)



my_data = {
    'hex': user_input,
    'mode': user_input_mode,
    'count': 5
}

response = requests.get(url, params=my_data)
data = response.json()
print (response.url)


#dict_keys(['mode', 'count', 'colors', 'seed', 'image', '_links', '_embedded'])

colors = data['colors']
hex_colors = [color['hex']['value'] for color in colors]
color_names = [color['name']['value'] for color in colors]

palette_width = 500
palette_height = 140

palette = Image.new('RGB', (palette_width, palette_height), 'white')
draw = ImageDraw.Draw(palette)

block_width = palette.width // len(hex_colors)

#for i, color in enumerate(hex_colors):
#    print(i, color)

for i, color in enumerate(hex_colors):
    x0 = i * block_width
    x1 = (i + 1) * block_width

    draw.rectangle((x0, 0, x1, 100), fill=color)
    draw.text((x0 + 20, 112), color, fill='black')
    draw.text((x0 + 20, 122), color_names[i], fill='black')

palette.show()
palette.save("palette.png")